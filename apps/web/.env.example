# PowerPay web — canonical v1.0.0

# Supported runtime networks
NEXT_PUBLIC_DEFAULT_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_ENABLE_MAINNET_BETA=false
POWERPAY_ENABLE_MAINNET_BETA=false
NEXT_PUBLIC_SOLANA_RPC_URL_DEVNET=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL_MAINNET_BETA=https://api.mainnet-beta.solana.com
SOLANA_RPC_URL_DEVNET=https://api.devnet.solana.com
SOLANA_RPC_URL_MAINNET_BETA=https://api.mainnet-beta.solana.com

# Deploy programs/pwrc-sale to each cluster before enabling purchases there.
NEXT_PUBLIC_POWERPAY_PROGRAM_ID_DEVNET=4snMyVjPbQMkZDQ6BKqrEv1HfJxVKwvpXvT2pB4QELiM
NEXT_PUBLIC_POWERPAY_PROGRAM_ID_MAINNET_BETA=4snMyVjPbQMkZDQ6BKqrEv1HfJxVKwvpXvT2pB4QELiM
POWERPAY_PROGRAM_ID_DEVNET=4snMyVjPbQMkZDQ6BKqrEv1HfJxVKwvpXvT2pB4QELiM
POWERPAY_PROGRAM_ID_MAINNET_BETA=4snMyVjPbQMkZDQ6BKqrEv1HfJxVKwvpXvT2pB4QELiM

# Canonical PWRC Token-2022 mint. Application fails closed on any other mint.
NEXT_PUBLIC_PWRC_MINT=PWRCRXXZxbg6FdQZfK3PMD7KP8xfxs9acvifJiG46wc

# Non-authoritative sale preview only. Mainnet always fails closed if live on-chain quote is unavailable.
PWRC_PER_SOL_FALLBACK=73500000
POWERPAY_REQUIRE_ONCHAIN_QUOTE=false

# Server-side SOL/USD market data. Never expose keys with NEXT_PUBLIC_ prefixes.
PYTH_API_KEY=
PYTH_HERMES_BASE_URL=https://pyth.dourolabs.app/hermes
PYTH_SOL_USD_FEED_ID=ef0d8b6fda2ceba41da15d4095d1da392a0d2f8ed0c6c7bc0f4cfac8c280b56d
BIRDEYE_API_KEY=
BIRDEYE_BASE_URL=https://public-api.birdeye.so
SOL_USD_FALLBACK=147
MARKET_STALE_AFTER_SECONDS=90

# Public origin encoded into Solana Pay transaction-request URLs.
# Use HTTPS outside local development.
NEXT_PUBLIC_APP_URL=http://localhost:3000
