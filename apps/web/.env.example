# PowerPay web application
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.devnet.solana.com

# Deploy `programs/pwrc-sale`, then replace this placeholder with the deployed id.
NEXT_PUBLIC_POWERPAY_PROGRAM_ID=4snMyVjPbQMkZDQ6BKqrEv1HfJxVKwvpXvT2pB4QELiM
POWERPAY_PROGRAM_ID=4snMyVjPbQMkZDQ6BKqrEv1HfJxVKwvpXvT2pB4QELiM

# Optional client-side mint hint for /send. If blank, /send discovers it from /api/quote.
NEXT_PUBLIC_PWRC_MINT=

# Non-authoritative sale preview only. Transaction building still requires live on-chain config.
PWRC_PER_SOL_FALLBACK=73500000
POWERPAY_REQUIRE_ONCHAIN_QUOTE=false

# Server-side SOL/USD market data. Never expose these keys with NEXT_PUBLIC_ prefixes.
# Pyth Hermes authentication is required for the current production Hermes service.
PYTH_API_KEY=
PYTH_HERMES_BASE_URL=https://pyth.dourolabs.app/hermes
PYTH_SOL_USD_FEED_ID=ef0d8b6fda2ceba41da15d4095d1da392a0d2f8ed0c6c7bc0f4cfac8c280b56d

# Birdeye acts as independent SOL/USD corroboration/fallback.
BIRDEYE_API_KEY=
BIRDEYE_BASE_URL=https://public-api.birdeye.so

# Market display fallback and freshness controls. Display only; never overrides the sale program.
SOL_USD_FALLBACK=147
MARKET_STALE_AFTER_SECONDS=90

# Public origin encoded into Solana Pay transaction-request URLs.
# Use a public HTTPS origin for staging/production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
